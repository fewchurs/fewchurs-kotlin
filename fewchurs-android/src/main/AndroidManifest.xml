<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <activity
            android:name="com.fewchurs.sdk.ui.FewchursActivity"
            android:exported="false"
            android:theme="@style/fewchurs_Theme"
            android:windowSoftInputMode="adjustResize" />

        <!-- Zero-code setup: reads com.fewchurs.sdk.API_KEY from the app's manifest. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="com.fewchurs.sdk.ui.FewchursInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>
</manifest>
